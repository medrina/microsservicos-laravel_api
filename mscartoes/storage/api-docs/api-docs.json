                                        "errors": {
                                            "type": "object"
                                        }
                                    },
                                    "type": "object"
                                },
                                "examples": {
                                    "preencha_nome": {
                                        "summary": "Erro no nome",
                                        "value": {
                                            "message": [
                                                "Informe o nome do cartão!",
                                                "Tamanho máximo nome do cartão não pode exceder 50 caracteres!"
                                            ],
                                            "errors": {
                                                "nome": [
                                                    "Informe o nome do cartão!",
                                                    "Tamanho máximo nome do cartão não pode exceder 50 caracteres!"
                                                ]
                                            }
                                        }
                                    },
                                    "preencha_bandeira": {
                                        "summary": "Erro na bandeira",
                                        "value": {
                                            "message": [
                                                "Informe o nome da bandeira!",
                                                "Nome da bandeira inválido!"
                                            ],
                                            "errors": {
                                                "bandeira": [
                                                    "Informe o nome da bandeira!",
                                                    "Nome da bandeira inválido!"
                                                ]
                                            }
                                        }
                                    },
                                    "preencha_renda": {
                                        "summary": "Erro na renda",
                                        "value": {
                                            "message": [
                                                "Informe a renda mínima desse cartão!",
                                                "Informe a renda mínima do cartão em formato numérico!"
                                            ],
                                            "errors": {
                                                "renda": [
