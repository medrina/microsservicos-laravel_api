{
  "vhosts": [
    {
      "name": "/"
    }
  ],

  "users": [
    {
      "name": "guest",
      "password": "guest",
      "tags": "administrator"
    }
  ],

  "permissions": [
    {
      "user": "guest",
      "vhost": "/",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],

  "exchanges": [
    {
      "name": "novo_cartao",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],

  "queues": [
    {
      "name": "emissao-cartao",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "default",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],

  "bindings": [
    {
      "source": "novo_cartao",
      "vhost": "/",
      "destination": "emissao-cartao",
      "destination_type": "queue",
      "routing_key": "novo_cartao",
      "arguments": {}
    }
  ]
}